# copy to .env and fill in (never commit .env or cookies.txt)
DISCORD_TOKEN=paste_your_bot_token_here

# YouTube sign-in (optional, e.g. Premium): pick ONE
# YT_COOKIES=cookies.txt      # a cookies.txt you export from your browser (best for a server)
# YT_BROWSER=chrome           # or read cookies straight from a browser on this computer

PREFIX=!
IDLE_LEAVE_S=300              # leave voice after 5 min with nothing playing
MAX_PLAYLIST=200
# ALLOWED_GUILDS=123456789012345678   # only answer in your own server(s), comma separated
ANNOUNCE=1                    # post "online" in #general when the bot starts
# ANNOUNCE_CHANNEL=general
